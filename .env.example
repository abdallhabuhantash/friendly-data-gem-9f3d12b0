# Local development configuration for the web app (public values only).
# Copy to .env.local and fill in the values from Lovable Cloud.
#
# Browser / client (required — without these the app cannot reach the backend):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# SSR / server functions (same public values, non-prefixed):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Optional. Not available on Lovable Cloud-managed backends — leave unset locally.
# Only the privileged endpoints need it (admin user management, the AI relay at
# /api/public/ai/*, and the stream proxy). Public pages, login and normal
# authenticated pages work without it.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only needed when running the local Python AI service relay.
# AI_SERVICE_KEY=
